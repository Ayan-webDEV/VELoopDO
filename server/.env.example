# VELoopDO Backend Configuration
# Copy this file to .env and replace the example values.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER_NAME:PASSOWRD@YOUR_CLUSTER.mongodb.net/veloopdo?retryWrites=true&w=majority

# Generate a long, random secret for JWT signing
JWT_SECRET=THE_JWT_SECRET

# Frontend origin allowed by the backend
CLIENT_ORIGIN=http://localhost:5173

# Initial company workspace
BOOTSTRAP_COMPANY_NAME=----
BOOTSTRAP_COMPANY_SLUG=----

# Authorised account 1 — Founder & CEO
USER1_NAME=Founder & CEO
USER1_EMAIL=founder@example.com
USER1_PASSWORD=PASSWORD_HARD

# Authorised account 2 — Marketing Director
USER2_NAME=Marketing Director
USER2_EMAIL=marketing@example.com
USER2_PASSWORD=PASSWORD_HARD

# Authentication settings
JWT_EXPIRES_IN=HOURS
LOGIN_MAX_ATTEMPTS=TIMES
LOGIN_WINDOW_MINUTES=MINUTES

# Task history and scheduling
APP_TIMEZONE=ZONE
DAILY_TASK_GENERATION_ENABLED=BOOLEAN